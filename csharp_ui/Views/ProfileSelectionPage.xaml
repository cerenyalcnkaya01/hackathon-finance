<Page x:Class="csharp_ui.Views.ProfileSelectionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="ProfileSelectionPage">
    <Grid Margin="40">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Profil Seçimi" Style="{StaticResource HeadingXL}" HorizontalAlignment="Center" Margin="0,0,0,40"/>
            
            <ItemsControl x:Name="ProfilesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CryptoCard}" Width="400" Margin="0,0,0,16" Cursor="Hand" MouseLeftButtonUp="Profile_Click" Background="{StaticResource BgCard}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource NeonGlowGradient}" Margin="0,0,16,0">
                                    <TextBlock Text="👤" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource HeadingMD}"/>
                                    <TextBlock Text="{Binding SelectedIndicators.Count, StringFormat={}{0} İndikatör seçili}" Style="{StaticResource BodySM}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Style="{StaticResource NeonButton}" Content="+ Yeni Profil Ekle" Width="200" Margin="0,20,0,0" Click="AddProfile_Click"/>
        </StackPanel>
    </Grid>
</Page>
