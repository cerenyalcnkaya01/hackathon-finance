<Page x:Class="csharp_ui.Views.StockDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      xmlns:vm="clr-namespace:csharp_ui.ViewModels"
      Title="StockDetailPage">
    <Page.RenderTransform>
        <TranslateTransform Y="0"/>
    </Page.RenderTransform>

    <Page.Triggers>
        <EventTrigger RoutedEvent="Page.Loaded">
            <BeginStoryboard Storyboard="{StaticResource FadeInAnimation}"/>
        </EventTrigger>
    </Page.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Navigation Area -->
        <Border Grid.Row="0" Background="#0D1318" BorderBrush="#1E2530" BorderThickness="0,0,0,1" Padding="16,8">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource GhostButton}" Content="← Geri" Click="Back_Click" Margin="0,0,16,0"/>
                <TextBlock Text="Hisse Detay" Style="{StaticResource HeadingMD}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- MAIN PANEL (Copied from original MainWindow) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="24,20,24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- Header + Search -->
                    <RowDefinition Height="Auto"/>   <!-- Stats Cards -->
                    <RowDefinition Height="360"/>    <!-- Chart -->
                    <RowDefinition Height="Auto"/>   <!-- Assets + AI -->
                </Grid.RowDefinitions>

                <!-- Header & Search -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Borsa Dashboard" Style="{StaticResource HeadingLG}" FontSize="20"/>
                        <TextBlock Text="Gerçek zamanlı borsa verisi ve AI destekli analiz" Style="{StaticResource BodySM}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox x:Name="SymbolBox" Style="{StaticResource DarkTextBox}" Text="{Binding SymbolInput, UpdateSourceTrigger=PropertyChanged}" Width="160" Margin="0,0,10,0"/>
                        <Button Style="{StaticResource NeonButton}" Content="Ara" Margin="0,0,10,0" Command="{Binding LoadStockCommand}"/>
                        <Button Style="{StaticResource GhostButton}" Content="🔄 Yenile" Command="{Binding RefreshAllCommand}"/>
                    </StackPanel>
                </Grid>

                <!-- Stats Cards -->
                <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,20">
                    <!-- Price -->
                    <Border Style="{StaticResource CryptoCard}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="FİYAT" Style="{StaticResource BodySM}" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="{Binding CurrentPrice}" Style="{StaticResource HeadingMD}" FontSize="22" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding PriceChange}" FontFamily="Segoe UI" FontSize="12" Margin="0,2,0,0" Foreground="{Binding PriceChangeColor, Converter={StaticResource StringToBrushConv}}"/>
                        </StackPanel>
                    </Border>
                    <!-- High -->
                    <Border Style="{StaticResource CryptoCard}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="EN YÜKSEK" Style="{StaticResource BodySM}" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="{Binding HighPrice}" Style="{StaticResource HeadingMD}" FontSize="22" Margin="0,4,0,0"/>
                            <TextBlock Text="Dönem içi" Style="{StaticResource BodySM}" FontSize="10"/>
                        </StackPanel>
                    </Border>
                    <!-- Low -->
                    <Border Style="{StaticResource CryptoCard}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="EN DÜŞÜK" Style="{StaticResource BodySM}" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="{Binding LowPrice}" Style="{StaticResource HeadingMD}" FontSize="22" Margin="0,4,0,0"/>
                            <TextBlock Text="Dönem içi" Style="{StaticResource BodySM}" FontSize="10"/>
                        </StackPanel>
                    </Border>
                    <!-- RSI -->
                    <Border Style="{StaticResource CryptoCard}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="RSI" Style="{StaticResource BodySM}" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="{Binding RsiText}" Style="{StaticResource HeadingMD}" FontSize="22" Margin="0,4,0,0"/>
                            <TextBlock Text="Momentum" Style="{StaticResource BodySM}" FontSize="10"/>
                        </StackPanel>
                    </Border>
                    <!-- Volume -->
                    <Border Style="{StaticResource CryptoCard}">
                        <StackPanel>
                            <TextBlock Text="HACİM" Style="{StaticResource BodySM}" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="{Binding VolumeText}" Style="{StaticResource HeadingMD}" FontSize="22" Margin="0,4,0,0"/>
                            <TextBlock Text="Son kapanış" Style="{StaticResource BodySM}" FontSize="10"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Chart + Quick Panel -->
                <Grid Grid.Row="2" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>

                    <!-- Chart Card -->
                    <Border Style="{StaticResource CryptoCard}" Margin="0,0,14,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedSymbol}" Style="{StaticResource HeadingMD}"/>
                                    <TextBlock Text="Kapanış fiyatı grafiği" Style="{StaticResource BodySM}" FontSize="10"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Style="{StaticResource PeriodButton}" Content="1A" Margin="0,0,4,0" Command="{Binding SetPeriodCommand}" CommandParameter="1mo"/>
                                    <Button Style="{StaticResource PeriodButton}" Content="3A" Margin="0,0,4,0" Command="{Binding SetPeriodCommand}" CommandParameter="3mo"/>
                                    <Button Style="{StaticResource PeriodButton}" Content="6A" Margin="0,0,4,0" Command="{Binding SetPeriodCommand}" CommandParameter="6mo"/>
                                    <Button Style="{StaticResource PeriodButton}" Content="1Y" Command="{Binding SetPeriodCommand}" CommandParameter="1y"/>
                                </StackPanel>
                            </Grid>

                            <lvc:CartesianChart Grid.Row="1" Series="{Binding ChartSeries}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}" LegendPosition="Hidden" Background="Transparent" TooltipPosition="Top"/>
                        </Grid>
                    </Border>

                    <!-- AI Analysis Card -->
                    <Border Grid.Column="1" Style="{StaticResource CryptoCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="✨ " FontSize="16"/>
                                    <TextBlock Text="AI Analiz" Style="{StaticResource HeadingMD}"/>
                                </StackPanel>
                                <TextBlock Text="Llama 3.1 · Borsa AI" Style="{StaticResource BodySM}" FontSize="10"/>
                            </StackPanel>

                            <Border Grid.Row="1" Background="#0A1015" CornerRadius="10" Padding="12">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding AiAnalysis}" Style="{StaticResource BodySM}" FontSize="11" TextWrapping="Wrap" LineHeight="18"/>
                                </ScrollViewer>
                            </Border>

                            <Button Grid.Row="2" Style="{StaticResource NeonButton}" Content="🤖 AI Analiz Yap" Command="{Binding AiAnalyzeCommand}" Margin="0,12,0,0"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Assets Table -->
                <Border Grid.Row="3" Style="{StaticResource CryptoCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Sektör Taraması" Style="{StaticResource HeadingMD}"/>
                                <TextBlock Style="{StaticResource BodySM}" FontSize="10">
                                    <Run Text="{Binding TotalAssets}"/>
                                    <Run Text=" sembol listelendi"/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource GhostButton}" Content="🇹🇷 BIST 30" Margin="0,0,8,0" Command="{Binding SetPresetCommand}" CommandParameter="bist30"/>
                                <Button Style="{StaticResource GhostButton}" Content="🇺🇸 US Tech" Command="{Binding SetPresetCommand}" CommandParameter="us_tech"/>
                            </StackPanel>
                        </Grid>

                        <DataGrid Grid.Row="1" Style="{StaticResource CryptoDataGrid}" ItemsSource="{Binding Assets}" MaxHeight="300">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Sembol" Binding="{Binding Symbol}" Width="120"/>
                                <DataGridTextColumn Header="Sektör" Binding="{Binding Sector}" Width="120"/>
                                <DataGridTextColumn Header="Son Fiyat" Binding="{Binding Close, StringFormat={}{0:N2}}" Width="100"/>
                                <DataGridTextColumn Header="RSI" Binding="{Binding Rsi, StringFormat={}{0:F1}}" Width="80"/>
                                <DataGridTemplateColumn Header="Sinyal" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="10" Height="10" Fill="{Binding SignalColor, Converter={StaticResource StringToBrushConv}}" Margin="4,0,8,0"/>
                                                <TextBlock Text="{Binding Signal}" Foreground="{Binding SignalColor, Converter={StaticResource StringToBrushConv}}" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Değişim" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ChangePctStr}" Foreground="{Binding ChangeColor, Converter={StaticResource StringToBrushConv}}" FontWeight="SemiBold" Padding="8,4"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
