<Page x:Class="csharp_ui.Views.AddProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="AddProfilePage">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <Button Style="{StaticResource GhostButton}" Content="← Geri" Click="Back_Click" Margin="0,0,16,0"/>
            <TextBlock Text="Yeni Profil Oluştur" Style="{StaticResource HeadingXL}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <TextBlock Text="PROFIL ADI" Style="{StaticResource BodySM}" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBox x:Name="ProfileNameBox" Style="{StaticResource DarkTextBox}" Width="400" HorizontalAlignment="Left" Text="Yeni Profil"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,0,0,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="İNDİKATÖRLER" Style="{StaticResource BodySM}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBox x:Name="SearchBox" Style="{StaticResource DarkTextBox}" Width="250" TextChanged="SearchBox_TextChanged" ToolTip="İndikatör Ara..."/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="IndicatorsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CryptoCard}" Margin="0,0,0,10" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource HeadingMD}"/>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource BodySM}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Button Grid.Row="3" Style="{StaticResource NeonButton}" Content="Profili Kaydet" Width="200" HorizontalAlignment="Left" Click="Save_Click"/>
    </Grid>
</Page>
