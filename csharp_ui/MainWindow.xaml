<Window x:Class="csharp_ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:vm="clr-namespace:csharp_ui.ViewModels"
        xmlns:conv="clr-namespace:csharp_ui.Converters"
        Title="Borsa AI — Cryptix Dashboard"
        Height="820" Width="1320"
        MinHeight="700" MinWidth="1100"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <!-- Root border: rounded window frame -->
    <Border Background="{StaticResource BgDeep}"
            CornerRadius="16"
            BorderBrush="#1E2530"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>   <!-- title bar -->
                <RowDefinition Height="*"/>    <!-- content -->
                <RowDefinition Height="28"/>   <!-- status bar -->
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════════════════
                 TITLE BAR
            ══════════════════════════════════════════════════════ -->
            <Border Grid.Row="0"
                    Background="#0D1318"
                    CornerRadius="16,16,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="22" Height="22" CornerRadius="6"
                                Background="{StaticResource NeonGlowGradient}" Margin="0,0,8,0">
                            <TextBlock Text="₿" Foreground="#0A0D0F" FontSize="12" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Borsa AI" Foreground="{StaticResource TextPrimary}"
                                   FontFamily="Segoe UI" FontSize="14" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text=" · Cryptix" Foreground="{StaticResource NeonGreen}"
                                   FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Window Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Width="14" Height="14" Background="#F59E0B" BorderThickness="0"
                                Click="Minimize_Click" Cursor="Hand" Margin="0,0,6,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Ellipse Fill="{TemplateBinding Background}" Width="14" Height="14"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Width="14" Height="14" Background="#10B981" BorderThickness="0"
                                Click="Maximize_Click" Cursor="Hand" Margin="0,0,6,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Ellipse Fill="{TemplateBinding Background}" Width="14" Height="14"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Width="14" Height="14" Background="#EF4444" BorderThickness="0"
                                Click="Close_Click" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Ellipse Fill="{TemplateBinding Background}" Width="14" Height="14"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════
                 MAIN CONTENT
            ══════════════════════════════════════════════════════ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>   <!-- Sidebar -->
                    <ColumnDefinition Width="*"/>     <!-- Main -->
                </Grid.ColumnDefinitions>

                <!-- ── SIDEBAR ──────────────────────────────────── -->
                <Border Grid.Column="0"
                        Background="#0D1318"
                        BorderBrush="#1E2530"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Nav items -->
                        <StackPanel Grid.Row="0" Margin="12,16">
                            <TextBlock Text="ANA MENÜ" Style="{StaticResource BodySM}"
                                       FontSize="10" FontWeight="Bold" Margin="14,0,0,10"/>

                            <Button Style="{StaticResource NavButtonActive}" Margin="0,2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📊 " FontSize="14"/>
                                    <TextBlock Text="Dashboard"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavButton}" Margin="0,2"
                                    Command="{Binding SetPresetCommand}" CommandParameter="bist30">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🇹🇷 " FontSize="14"/>
                                    <TextBlock Text="BIST 30"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavButton}" Margin="0,2"
                                    Command="{Binding SetPresetCommand}" CommandParameter="us_tech">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🇺🇸 " FontSize="14"/>
                                    <TextBlock Text="US Tech"/>
                                </StackPanel>
                            </Button>

                            <Separator Background="#1E2530" Margin="14,12"/>

                            <TextBlock Text="ANALİZ" Style="{StaticResource BodySM}"
                                       FontSize="10" FontWeight="Bold" Margin="14,0,0,10"/>
                            <Button Style="{StaticResource NavButton}" Margin="0,2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📈 " FontSize="14"/>
                                    <TextBlock Text="RSI Tarama"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavButton}" Margin="0,2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡ " FontSize="14"/>
                                    <TextBlock Text="MACD Tarama"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- AI Panel (bottom) -->
                        <Border Grid.Row="2" Margin="12,0,12,12" CornerRadius="12"
                                Background="#0D1F1A" BorderBrush="#1E3D2A" BorderThickness="1"
                                Padding="12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource NeonGreen}"
                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="AI Destekli" Style="{StaticResource NeonLabel}" FontSize="11"/>
                                </StackPanel>
                                <TextBlock Text="Llama 3.1 ile güçlendirilmiş borsa analizi"
                                           Style="{StaticResource BodySM}" FontSize="10" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ── MAIN PANEL ────────────────────────────────── -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <Grid Margin="24,20,24,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>   <!-- Header + Search -->
                            <RowDefinition Height="Auto"/>   <!-- Stats Cards -->
                            <RowDefinition Height="360"/>    <!-- Chart -->
                            <RowDefinition Height="Auto"/>   <!-- Assets + AI -->
                        </Grid.RowDefinitions>

                        <!-- ── Header & Search ── -->
                        <Grid Grid.Row="0" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Main Dashboard" Style="{StaticResource HeadingLG}" FontSize="20"/>
                                <TextBlock Text="Gerçek zamanlı borsa verisi ve AI destekli analiz"
                                           Style="{StaticResource BodySM}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="SymbolBox"
                                         Style="{StaticResource DarkTextBox}"
                                         Text="{Binding SymbolInput, UpdateSourceTrigger=PropertyChanged}"
                                         Width="160" Margin="0,0,10,0"
                                         KeyDown="SymbolBox_KeyDown"/>
                                <Button Style="{StaticResource NeonButton}"
                                        Content="Ara" Margin="0,0,10,0"
                                        Command="{Binding LoadStockCommand}"/>
                                <Button Style="{StaticResource GhostButton}"
                                        Content="🔄 Yenile"
                                        Command="{Binding RefreshAllCommand}"/>
                            </StackPanel>
                        </Grid>

                        <!-- ── Stats Cards ── -->
                        <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,20">
                            <!-- Price -->
                            <Border Style="{StaticResource CryptoCard}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="FİYAT" Style="{StaticResource BodySM}" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding CurrentPrice}" Style="{StaticResource HeadingMD}"
                                               FontSize="22" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding PriceChange}" FontFamily="Segoe UI" FontSize="12"
                                               Margin="0,2,0,0"
                                               Foreground="{Binding PriceChangeColor, Converter={StaticResource StringToBrushConv}}"/>
                                </StackPanel>
                            </Border>
                            <!-- High -->
                            <Border Style="{StaticResource CryptoCard}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="EN YÜKSEK" Style="{StaticResource BodySM}" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding HighPrice}" Style="{StaticResource HeadingMD}" FontSize="22" Margin="0,4,0,0"/>
                                    <TextBlock Text="Dönem içi" Style="{StaticResource BodySM}" FontSize="10"/>
                                </StackPanel>
                            </Border>
                            <!-- Low -->
                            <Border Style="{StaticResource CryptoCard}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="EN DÜŞÜK" Style="{StaticResource BodySM}" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding LowPrice}" Style="{StaticResource HeadingMD}" FontSize="22" Margin="0,4,0,0"/>
                                    <TextBlock Text="Dönem içi" Style="{StaticResource BodySM}" FontSize="10"/>
                                </StackPanel>
                            </Border>
                            <!-- RSI -->
                            <Border Style="{StaticResource CryptoCard}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="RSI" Style="{StaticResource BodySM}" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding RsiText}" Style="{StaticResource HeadingMD}" FontSize="22" Margin="0,4,0,0"/>
                                    <TextBlock Text="Momentum" Style="{StaticResource BodySM}" FontSize="10"/>
                                </StackPanel>
                            </Border>
                            <!-- Volume -->
                            <Border Style="{StaticResource CryptoCard}">
                                <StackPanel>
                                    <TextBlock Text="HACİM" Style="{StaticResource BodySM}" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding VolumeText}" Style="{StaticResource HeadingMD}" FontSize="22" Margin="0,4,0,0"/>
                                    <TextBlock Text="Son kapanış" Style="{StaticResource BodySM}" FontSize="10"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- ── Chart + Quick Panel ── -->
                        <Grid Grid.Row="2" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="280"/>
                            </Grid.ColumnDefinitions>

                            <!-- Chart Card -->
                            <Border Style="{StaticResource CryptoCard}" Margin="0,0,14,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Chart header -->
                                    <Grid Grid.Row="0" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding SelectedSymbol}" Style="{StaticResource HeadingMD}"/>
                                            <TextBlock Text="Kapanış fiyatı grafiği" Style="{StaticResource BodySM}" FontSize="10"/>
                                        </StackPanel>
                                        <!-- Period Buttons -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Style="{StaticResource PeriodButton}" Content="1A" Margin="0,0,4,0"
                                                    Command="{Binding SetPeriodCommand}" CommandParameter="1mo"/>
                                            <Button Style="{StaticResource PeriodButton}" Content="3A" Margin="0,0,4,0"
                                                    Command="{Binding SetPeriodCommand}" CommandParameter="3mo"/>
                                            <Button Style="{StaticResource PeriodButton}" Content="6A" Margin="0,0,4,0"
                                                    Command="{Binding SetPeriodCommand}" CommandParameter="6mo"/>
                                            <Button Style="{StaticResource PeriodButton}" Content="1Y"
                                                    Command="{Binding SetPeriodCommand}" CommandParameter="1y"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- LiveChart -->
                                    <lvc:CartesianChart Grid.Row="1"
                                                        Series="{Binding ChartSeries}"
                                                        XAxes="{Binding XAxes}"
                                                        YAxes="{Binding YAxes}"
                                                        LegendPosition="Hidden"
                                                        Background="Transparent"
                                                        TooltipPosition="Top"/>
                                </Grid>
                            </Border>

                            <!-- AI Analysis Card -->
                            <Border Grid.Column="1" Style="{StaticResource CryptoCard}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="✨ " FontSize="16"/>
                                            <TextBlock Text="AI Analiz" Style="{StaticResource HeadingMD}"/>
                                        </StackPanel>
                                        <TextBlock Text="Llama 3.1 · Borsa AI" Style="{StaticResource BodySM}" FontSize="10"/>
                                    </StackPanel>

                                    <Border Grid.Row="1" Background="#0A1015" CornerRadius="10" Padding="12">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <TextBlock Text="{Binding AiAnalysis}"
                                                       Style="{StaticResource BodySM}"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       LineHeight="18"/>
                                        </ScrollViewer>
                                    </Border>

                                    <Button Grid.Row="2" Style="{StaticResource NeonButton}"
                                            Content="🤖 AI Analiz Yap"
                                            Command="{Binding AiAnalyzeCommand}"
                                            Margin="0,12,0,0"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ── Assets Table ── -->
                        <Border Grid.Row="3" Style="{StaticResource CryptoCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Hisse Taraması" Style="{StaticResource HeadingMD}"/>
                                        <TextBlock Style="{StaticResource BodySM}" FontSize="10">
                                            <Run Text="{Binding TotalAssets}"/>
                                            <Run Text=" sembol listelendi"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource GhostButton}" Content="🇹🇷 BIST 30"
                                                Margin="0,0,8,0"
                                                Command="{Binding SetPresetCommand}" CommandParameter="bist30"/>
                                        <Button Style="{StaticResource GhostButton}" Content="🇺🇸 US Tech"
                                                Command="{Binding SetPresetCommand}" CommandParameter="us_tech"/>
                                    </StackPanel>
                                </Grid>

                                <DataGrid Grid.Row="1"
                                          Style="{StaticResource CryptoDataGrid}"
                                          ItemsSource="{Binding Assets}"
                                          MaxHeight="300">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Sembol" Binding="{Binding Symbol}" Width="120"/>
                                        <DataGridTextColumn Header="Son Fiyat" Binding="{Binding Close, StringFormat={}{0:N2}}" Width="100"/>
                                        <DataGridTextColumn Header="RSI" Binding="{Binding Rsi, StringFormat={}{0:F1}}" Width="80"/>
                                        <DataGridTextColumn Header="Sinyal" Binding="{Binding Signal}" Width="100"/>
                                        <DataGridTemplateColumn Header="Değişim" Width="120">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding ChangePctStr}"
                                                               Foreground="{Binding ChangeColor, Converter={StaticResource StringToBrushConv}}"
                                                               FontWeight="SemiBold" Padding="8,4"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- ══════════════════════════════════════════════════════
                 STATUS BAR
            ══════════════════════════════════════════════════════ -->
            <Border Grid.Row="2" Background="#0A0D0F"
                    CornerRadius="0,0,16,16"
                    BorderBrush="#1E2530" BorderThickness="0,1,0,0">
                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusText}"
                               FontFamily="Segoe UI" FontSize="11"
                               VerticalAlignment="Center"
                               Foreground="{Binding IsConnected, Converter={StaticResource BoolToColorConv}}"/>

                    <!-- Loading Indicator -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConv}}">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource NeonGreen}" Margin="0,0,6,0">
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="1" To="0.2" Duration="0:0:0.8"
                                                             AutoReverse="True"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <TextBlock Text="Yükleniyor..." FontFamily="Segoe UI" FontSize="11"
                                   Foreground="{StaticResource NeonGreen}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
